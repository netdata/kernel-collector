FROM alpine:3.24 AS build

ARG ARCH=x86
ENV ARCH=$ARCH

ARG KERNEL_VERSION=5.4.20
ENV KERNEL_VERSION=$KERNEL_VERSION
ARG KERNEL_LOCALVERSION=
ENV KERNEL_LOCALVERSION=$KERNEL_LOCALVERSION

ENV _LIBC=musl

# hadolint ignore=DL3018
RUN apk add --no-cache -U build-base autoconf automake coreutils pkgconfig \
                          bc elfutils-dev openssl-dev clang clang-dev llvm \
                          rsync bison flex tar xz bash git linux-headers

# hadolint ignore=DL3003,SC3009
RUN mkdir -p /usr/src && \
    cd /usr/src && \
    SOURCE_KERNEL_VERSION=$(echo "$KERNEL_VERSION" | sed -E 's/\.0$//') && \
    wget -q https://cdn.kernel.org/pub/linux/kernel/v$(echo "$SOURCE_KERNEL_VERSION" | cut -f 1 -d '.').x/linux-${SOURCE_KERNEL_VERSION}.tar.xz && \
    tar -xf linux-${SOURCE_KERNEL_VERSION}.tar.xz && \
    ln -s linux-${SOURCE_KERNEL_VERSION} linux && \
    ln -s /usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/include/stdarg.h /usr/src/linux/include/

WORKDIR /kernel-collector

COPY .dockerfiles/build.sh /build.sh
COPY . .

CMD ["/build.sh"]
